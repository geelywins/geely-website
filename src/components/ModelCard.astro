---
import { href, asset } from '../lib/url';
import type { GeelyModel } from '../lib/data';
interface Props { m: GeelyModel; delay?: number; heading?: 'h2' | 'h3' }
const { m, delay = 0, heading = 'h3' } = Astro.props;
const H = heading;
---
<a class="card-x model-card reveal" style={`--d:${delay}s`} href={href(`/model/${m.slug}/`)}>
  <div class="card-media">
    {m.model3d && <span class="v3d-badge">360&deg;</span>}
    {m.foto
      ? <img src={asset(m.foto)} alt={m.nama} loading="lazy" decoding="async" width="640" height="400" />
      : <div class="media-fallback" style={`--c:${m.warna}`}><span>{m.nama.replace('Geely ', '')}</span></div>}
  </div>
  <div class="card-body-x">
    <span class="tag">{m.tipe}</span>
    <H class="card-title-x">{m.nama}</H>
    <p>{m.ringkas}</p>
    <span class="link-more">Lihat detail <span aria-hidden="true">&rarr;</span></span>
  </div>
</a>
