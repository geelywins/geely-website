---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import DeliveryCard from '../../components/DeliveryCard.astro';
import { DELIVERY } from '../../lib/data';
import { CONTENT, waLink } from '../../config';
const P = CONTENT.halamanDelivery;
---
<Base title="Delivery Moment Geely" description={P.seoDeskripsi}>
  <PageHead title={P.judul} text={P.teks} crumbs={[{ label: 'Delivery' }]} />
  <section><div class="container">
    {DELIVERY.length === 0
      ? <p class="text-muted">{P.kosong} <a href={waLink()} target="_blank" rel="noopener">Chat WhatsApp</a></p>
      : <div class="delivery-grid">{DELIVERY.map((d, i) => <DeliveryCard d={d} delay={(i % 4) * 0.07} />)}</div>}
  </div></section>
</Base>
