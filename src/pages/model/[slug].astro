---
import Base from '../../layouts/Base.astro';
import { MODELS, getModel, ACTIVE_PROMOS } from '../../lib/data';
import { getLiveArticles } from '../../lib/articles';
import PageHead from '../../components/PageHead.astro';
import PromoCard from '../../components/PromoCard.astro';
import Icon from '../../components/Icon.astro';
import { waLink, SITE } from '../../config';
import { href, asset } from '../../lib/url';

export function getStaticPaths() {
  return MODELS.map((m) => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const m = getModel(slug!)!;
const promos = ACTIVE_PROMOS.filter((p) => p.model === m.slug);
const needle = m.nama.toLowerCase();
const artikelTerkait = (await getLiveArticles())
  .filter((a) => (a.data.title + ' ' + a.data.tags.join(' ')).toLowerCase().includes(needle) || (a.data.title + ' ' + a.data.tags.join(' ')).toLowerCase().includes(needle.replace('geely ', '')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const galeri = (m.galeri ?? []).filter(Boolean);

const url = new URL(href(`/model/${m.slug}/`), Astro.site).href;
const fotoAbs = m.foto ? new URL(asset(m.foto), Astro.site).href : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Car',
    name: m.nama,
    brand: { '@type': 'Brand', name: 'Geely' },
    description: m.deskripsi,
    image: fotoAbs,
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL(href('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Model Mobil', item: new URL(href('/model/'), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: m.nama, item: url },
    ],
  },
];
const lokasi = SITE.locations.map((l) => l.nama).join(' dan ');
---

<Base
  title={`${m.nama} - Harga, Promo & Test Drive`}
  description={`${m.ringkas} Tanyakan harga, promo dan jadwal test drive ${m.nama} di ${lokasi}.`}
  image={m.foto || undefined}
  jsonLd={jsonLd}
>
  <PageHead title={m.nama} text={m.ringkas} crumbs={[{ label: 'Model Mobil', url: href('/model/') }, { label: m.nama }]}>
    <span class="tag mt-2">{m.tipe}</span>
  </PageHead>

  <section>
    <div class="container prose">
      <div class="model-hero reveal">
        {m.foto
          ? <img src={asset(m.foto)} alt={m.nama} width="1200" height="675" fetchpriority="high" />
          : <div class="media-fallback" style={`--c:${m.warna}`}><span>{m.nama}</span></div>}
      </div>

      <h2>Tentang {m.nama}</h2>
      <p>{m.deskripsi}</p>

      {m.keunggulan.length > 0 && (<><h2>Keunggulan</h2><ul>{m.keunggulan.map((k) => <li>{k}</li>)}</ul></>)}

      {galeri.length > 0 && (
        <>
          <h2>Galeri Foto</h2>
          <div class="gallery">
            {galeri.map((g, i) => (
              <button type="button" data-bs-toggle="modal" data-bs-target="#lightbox" data-full={asset(g)} data-caption={`${m.nama} foto ${i + 1}`} aria-label={`Perbesar foto ${i + 1}`}>
                <img src={asset(g)} alt={`${m.nama} foto ${i + 1}`} loading="lazy" decoding="async" width="400" height="300" />
              </button>
            ))}
          </div>
        </>
      )}

      <h2>Spesifikasi &amp; Harga</h2>
      <table class="spec">
        {m.spesifikasi.map((s) => <tr><td>{s.label}</td><td>{s.nilai}</td></tr>)}
        <tr><td>Harga</td><td>{m.harga}</td></tr>
      </table>
      <p class="mt-3 small text-muted">Harga dan spesifikasi dapat berubah sewaktu-waktu.</p>

      {promos.length > 0 && (
        <>
          <h2>Promo {m.nama}</h2>
          <div class="grid-x">{promos.map((p) => <PromoCard p={p} />)}</div>
        </>
      )}

      {artikelTerkait.length > 0 && (
        <>
          <h2>Artikel tentang {m.nama}</h2>
          <ul>{artikelTerkait.map((a) => <li><a href={href(`/artikel/${a.id}/`)}>{a.data.title}</a></li>)}</ul>
        </>
      )}

      <div class="cta-box reveal">
        <h3>Tertarik dengan {m.nama}?</h3>
        <p>Minta harga terbaru, simulasi kredit, atau jadwalkan test drive sekarang.</p>
        <a class="btn btn-wa btn-lg" href={waLink(`Halo Kak Wins, saya tertarik dengan ${m.nama}. Boleh minta harga, promo dan simulasi kreditnya?`)} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Tanya {m.nama}</a>
      </div>
    </div>
  </section>
</Base>
