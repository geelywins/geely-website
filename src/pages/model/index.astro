---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ModelCard from '../../components/ModelCard.astro';
import { MODELS } from '../../lib/data';
import { CONTENT } from '../../config';
const P = CONTENT.halamanModel;
---
<Base title="Model Mobil Geely: EX2, EX5, Starray" description={P.seoDeskripsi}>
  <PageHead title={P.judul} text={P.teks} crumbs={[{ label: 'Model Mobil' }]} />
  <section><div class="container"><div class="grid-models">{MODELS.map((m, i) => <ModelCard m={m} delay={i * 0.07} heading="h2" />)}</div></div></section>
</Base>
