---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PromoCard from '../../components/PromoCard.astro';
import { ACTIVE_PROMOS } from '../../lib/data';
import { CONTENT } from '../../config';
const P = CONTENT.halamanPromo;
---
<Base title="Promo Geely Terbaru" description={P.seoDeskripsi}>
  <PageHead title={P.judul} text={P.teks} crumbs={[{ label: 'Promo' }]} />
  <section><div class="container">
    {ACTIVE_PROMOS.length === 0 ? <p class="text-muted">{P.kosong}</p> : <div class="grid-x">{ACTIVE_PROMOS.map((p, i) => <PromoCard p={p} delay={i * 0.07} heading="h2" />)}</div>}
  </div></section>
</Base>
