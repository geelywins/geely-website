---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import TestimoniCard from '../../components/TestimoniCard.astro';
import { TESTIMONI } from '../../lib/data';
import { CONTENT, waLink } from '../../config';
const P = CONTENT.halamanTestimoni;
---
<Base title="Testimoni Pelanggan Geely" description={P.seoDeskripsi}>
  <PageHead title={P.judul} text={P.teks} crumbs={[{ label: 'Testimoni' }]} />
  <section><div class="container">
    {TESTIMONI.length === 0
      ? <p class="text-muted">{P.kosong} <a href={waLink()} target="_blank" rel="noopener">Chat WhatsApp</a></p>
      : <div class="grid-x">{TESTIMONI.map((t, i) => <TestimoniCard t={t} delay={(i % 3) * 0.07} />)}</div>}
  </div></section>
</Base>
